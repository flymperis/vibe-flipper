# Copy to .env and adjust. Most values can also be changed later from the Settings page.

# Ollama on your server (qwen). Leave empty to use rules only.
# Ollama on the host:            http://host.docker.internal:11434  (docker/podman-compose)
#                                 http://host.containers.internal:11434  (podman / Quadlet)
# Ollama container, same network: http://ollama:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
# rules | llm | hybrid
MATCHING_MODE=hybrid
LLM_MAX_CALLS_PER_RUN=150

SCRAPE_INTERVAL_MINUTES=20
ENABLED_SOURCES=insomnia,vendora,vinted
REQUEST_DELAY_SECONDS=2
# First run on an empty DB: crawl EVERY Insomnia page (all categories, ~19k ads, ~45-60 min)
INSOMNIA_FULL_INITIAL=true
# Regular (delta) runs read newest-first feeds until a page has only known ads, capped at:
INSOMNIA_PAGES=30
FEED_PAGES=10
# Deeper fixed crawl used by --backfill
INSOMNIA_BACKFILL_PAGES=15
# Vinted category filter (2994 = Electronics)
VINTED_CATALOG_IDS=2994
# Only sellers from these countries count (comma separated ISO codes, empty = all).
# Vinted seller countries are looked up once per seller via Vinted's users API.
ALLOWED_COUNTRIES=GR

# Category feeds crawled every run (GPUs/CPUs are found only through these)
INSOMNIA_FEED_CATEGORIES=11-kartes-grafikon,9-epexergastes,47-mnimes,89-ssd,10-hdd-optika-mesa,15-ipad
VENDORA_FEED_CATEGORIES=6ljwnv,qrzg1v
VINTED_FEED_CATALOGS=3602,3599,3603,3607,3728
FEED_BACKFILL_PAGES=12
VINTED_USER_LOOKUPS_PER_RUN=300

STATS_WINDOW_DAYS=30
# Unmatched / foreign listings not seen for this many days are deleted daily (0 = keep forever)
RETENTION_DAYS=30
FEE_PCT=0
FEE_FIXED=0
